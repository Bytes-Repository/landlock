;; ── Gotowe zestawy praw ─────────────────────────────────────────────────────
;; landlock(7) zaleca obejmowac tyle praw, ile dana wersja ABI zna, zamiast
;; wpisywac na sztywno jeden konkretny zestaw bitow - inaczej program
;; skompilowany dzis przestanie ograniczac nowe prawa dodane w przyszlych
;; jadrach (np. nowy typ pliku), bo `handled_access_fs` ich po prostu nie
;; wymieni.
pub fn access_fs_all_for_abi(abi: int) -> int is
    let mut mask: int = access_fs_execute()     | access_fs_write_file() |
                         access_fs_read_file()  | access_fs_read_dir()   |
                         access_fs_remove_dir() | access_fs_remove_file() |
                         access_fs_make_char()  | access_fs_make_dir()   |
                         access_fs_make_reg()   | access_fs_make_sock()  |
                         access_fs_make_fifo()  | access_fs_make_block() |
                         access_fs_make_sym()
    if abi >= 2 is mask = mask | access_fs_refer()     end
    if abi >= 3 is mask = mask | access_fs_truncate()  end
    if abi >= 5 is mask = mask | access_fs_ioctl_dev() end
    return mask
end

;; Wygodny zestaw "tylko do odczytu": czytanie plikow, przegladanie
;; katalogow i wykonywanie binariow (bez wykonywania EXECUTE ograniczenie
;; byloby bezuzyteczne dla wiekszosci sandboxow, ktore wciaz musza
;; uruchamiac programy z dozwolonych sciezek).
pub fn access_fs_read_only() -> int is
    return access_fs_read_file() | access_fs_read_dir() | access_fs_execute()
end

pub fn access_net_all_for_abi(abi: int) -> int is
    if abi >= 4 is return access_net_bind_tcp() | access_net_connect_tcp() end
    return 0
end

pub fn scope_all_for_abi(abi: int) -> int is
    if abi >= 6 is return scope_abstract_unix_socket() | scope_signal() end
    return 0
end

